prefix=/usr/local
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gperftools
Version: 2.9.0
Description: Performance tools for C++
URL: http://code.google.com/p/gperftools/
Requires:
Libs: -L${libdir} -ltcmalloc_minimal_debug
Libs.private: -lpthread
Cflags: -I${includedir}

